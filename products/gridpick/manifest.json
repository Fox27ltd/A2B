{
  "manifest_version": 3,
  "name": "Gridpick — Copy Any Table or List to CSV",
  "version": "1.0.0",
  "description": "Turn any table, product grid or search-results list into CSV, Excel, JSON or Markdown. One click. No account needed.",
  "minimum_chrome_version": "102",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Gridpick — copy this page's data",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open Gridpick"
    }
  }
}
